# =========================
# Компьютер: камера и Bluetooth
# =========================
CAMERA_ID=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
BT_PORT=/dev/rfcomm0
BT_BAUDRATE=9600
BT_HC06_MAC=98:D3:11:FD:1C:0B
COMMAND_RESEND_INTERVAL_S=0.10

# Путь к Pico SDK и точка монтирования Pico в режиме BOOTSEL.
# Замените /home/your-user на путь своего компьютера.
PICO_SDK_PATH=/home/your-user/pico/pico-sdk
PICO_MOUNT_POINT=/run/media/your-user/RPI-RP2

# =========================
# Поле и компьютерное зрение
# =========================
FIELD_WIDTH_MM=1500
FIELD_HEIGHT_MM=1500
VIRTUAL_FIELD_WIDTH=800
VIRTUAL_FIELD_HEIGHT=600
BALL_HSV_LOWER=0,184,100
BALL_HSV_UPPER=15,255,255
ROBOT_HSV_LOWER=100,80,80
ROBOT_HSV_UPPER=140,255,255
BALL_TIMEOUT_S=0.25
BALL_CURVATURE_K=1.2
BALL_FRICTION=0.015
BALL_RESTITUTION=0.82
BALL_MAX_SIM_STEPS=180
BALL_HISTORY_LENGTH=10
BALL_MIN_RADIUS_PX=3
BALL_MAX_RADIUS_PX=50
BALL_MIN_AREA_PX=20
BALL_MIN_CIRCULARITY=0.45
BALL_MIN_PREDICTION_SPEED_MM_S=10
BALL_STOP_SPEED_MM_S=5
ROBOT_TRACKER_FILTER_LENGTH=5
ROBOT_MIN_RADIUS_PX=5
ROBOT_MAX_RADIUS_PX=60

# =========================
# Каретка робота
# Значения нужно подстроить по реальному железу.
# =========================
CONTROLLER_MAX_SPEED_MM_S=900
CONTROLLER_MAX_ACC_MM_S2=1800
CONTROLLER_DEADBAND_MM=20
MOTOR_MAX_PWM=255

# =========================
# Pico: прошивка читает эти значения при сборке.
# Не меняйте пины без проверки схемы.
# =========================
PICO_MOTOR_WRAP=255
PICO_MOTOR_FREQ_HZ=5000
PICO_SERVO_WRAP=19999
PICO_SERVO_DIVIDER=125.0
PICO_ESC_MIN_PULSE=1000
PICO_ESC_MAX_PULSE=2000
PICO_ESC1_TARGET_PULSE=1200
PICO_ESC2_TARGET_PULSE=1020
PICO_COMMAND_TIMEOUT_MS=400
PICO_CALIBRATE_ESC_ON_BOOT=0
PICO_UART_BAUDRATE=9600
PICO_PIN_TX=0
PICO_PIN_RX=1
PICO_PIN_LED=2
PICO_PIN_BUTTON=5
PICO_PIN_SERVO1=12
PICO_PIN_SERVO2=13
PICO_PIN_MOTOR_LEFT=10
PICO_PIN_MOTOR_RIGHT=11
PICO_PIN_BATTERY=26

# =========================
# Необязательный эксперимент: YOLO
# Обычному запуску робота эти настройки не нужны.
# =========================
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.25
YOLO_DEFAULT_EPOCHS=50
YOLO_IMAGE_SIZE=640
YOLO_BATCH_SIZE=16
YOLO_FREEZE_LAYERS=10
YOLO_PATIENCE=50
YOLO_WORKERS=8
YOLO_VALIDATION_FRACTION=0.20
YOLO_RANDOM_SEED=42
